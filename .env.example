# ==========================================
# NexusVoice — Environment Configuration
# ==========================================

# LiveKit Cloud (Free 50GB / 100 rooms: cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech-to-Text (STT) - $200 Free Credits: deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# Fast LLM Provider (Default: groq | cerebras)
LLM_PROVIDER=groq
# Groq 100% Free API Key: console.groq.com
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile

# (Optional) Cerebras API Key: cloud.cerebras.ai
# CEREBRAS_API_KEY=your_cerebras_key

# Text-to-Speech (TTS)
# (Optional) Cartesia API Key (cartesia.ai) — if omitted, uses Deepgram Aura TTS automatically
# CARTESIA_API_KEY=your_cartesia_key
# CARTESIA_VOICE_ID=248be419-c632-4f23-adf1-5324ed7dbf1d

# Custom Prompt & Greeting
NEXUS_VOICE_GREETING=Hello! I am NexusVoice. How can I assist you today?
